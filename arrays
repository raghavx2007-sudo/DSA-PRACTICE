        scanf("%d",&b[i]);

    int i=0, j=0, k=0;

    while(i<n && j<m) {
        if(a[i]<b[j])
            c[k++]=a[i++];
        else
            c[k++]=b[j++];
    }

    while(i<n)
        c[k++]=a[i++];

    while(j<m)
        c[k++]=b[j++];

    if (k%2==0)
        printf("%.1f",(c[k/2-1]+c[k/2])/2.0);
