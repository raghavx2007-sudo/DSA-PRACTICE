40. Maximum Rectangle Area in Histogram
Description


Given bar heights of a histogram, find the largest rectangular area.


Sample Input
7
6 2 5 4 5 1 6
Sample Output
12
Explanation


The maximum rectangle area is formed by bars with heights 4,5,5 resulting in area 12.
#include <stdio.h>

int main() {
    int n, a[1000];
    int maxArea = 0;

    scanf("%d",&n);

    for (int i=0;i<n;i++)
        scanf("%d",&a[i]);

    for (int i=0;i<n;i++) {
        int minHeight=a[i];

        for(int j=i;j<n;j++){
            if(a[j]<minHeight)
                minHeight=a[j];

            int area=minHeight*(j-i+1);

            if (area>maxArea)
                maxArea=area;
        }
    }

    printf("%d",maxArea);

    return 0;
}




