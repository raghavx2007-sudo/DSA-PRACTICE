Perfect-deficit-abundant Numbers
#include <stdio.h>
#include <math.h>
int main()
{
         int n;
         int sum=0;
         scanf("%d",&n);
         for(int i=1;i<=sqrt(n);i++){
             if(n%i==0){
                 sum=sum+i+(n/i);
             }
         }
         if(sum-n==n)printf("Perfect Number");
         else if(sum-n>n)printf("Deficit Number");
         else printf("Abundant Number");

    return 0;
}
