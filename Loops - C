Magic Number

#include <stdio.h>
#include <math.h>
int main()
{   int num,sum=0;
    scanf("%d",&num);
    while(num>0){
         int samp=num;
            num/=10;
           int d=samp-(num*10);
            sum+=d;
            if(num<=0 && sum>9){
                num=sum;
                sum=0;
            }
    }
    printf("%d",sum);
    return 0;
}

