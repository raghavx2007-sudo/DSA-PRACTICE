1. Balanced Brackets Checker
Detailed Scenario
A compiler assistant must quickly verify whether every opening bracket in a student program is closed in the correct order.
Detailed Description
Given a string containing only brackets (), {}, and [], determine whether the string is balanced. A string is balanced when 
each opening bracket has the same type of closing bracket and brackets close in the correct order.
Input Format
A single string S containing bracket characters.
Output Format
Print YES if the bracket string is balanced, otherwise print NO.
Constraints


1 <= |S| <= 100000
S contains only characters from: ( ) { } [ ]
Sample Input
{[()]}
Sample Output
YES
Explanation
Push opening brackets into a stack. When a closing bracket appears, the top of the stack must contain its matching opening 
bracket. At the end, the stack must be empty.
Array Implimentation:
#include <stdio.h>
int main()
{ 
    char arr[100];
    scanf(" %[^\n]",arr);
    char stack[100];
    int top=-1;
    for(int i=0;arr[i]!='\0';i++){
        if(arr[i]=='(' || arr[i]=='[' || arr[i]=='{' ){
            stack[++top]=arr[i];
        }
        else if(top!=-1){
            if(arr[i]=='}' && stack[top]!='{'){printf("Invalid");return 0;}
             if(arr[i]==')' && stack[top]!='('){printf("Invalid");return 0;}
              if(arr[i]==']' && stack[top]!='['){printf("Invalid");return 0;}
            top--;
        }
        else{
            printf("Invalid");
            return 0;
        }
    }
if(top!=-1)printf("Invalid");
else{
printf("Valid");
    }
    return 0;
}
Linked List Implementation :
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct node 
{
    char data;
    struct node * next;
}*head=NULL;
void push(char val){
    struct node * newnode = (struct node*)malloc(sizeof(struct node));
    newnode -> data = val;
    newnode -> next = head;
    head = newnode;
}
void pop(){
    struct node * temp = head;
    head = head -> next;
    free(temp);
}
int main()
{ 
    char arr[100];
    scanf("%[^\n]",arr);
    for(int i=0;arr[i]!='\0';i++){
        if(arr[i]=='('||arr[i]=='{'||arr[i]=='['){
            push(arr[i]);
        }
        else{
            if(head==NULL){printf("Invalid");return 0;}
            if(arr[i]=='}' && head -> data != '{'){printf("Invalid");return 0;}
            if(arr[i]==')' && head -> data != '('){printf("Invalid");return 0;}
            if(arr[i]==']' && head -> data != '['){printf("Invalid");return 0;}
            pop();
        }
    }
    if(head==NULL)printf("valid");
    else printf("Invlalid");
    return 0;
}
2. Remove Adjacent Duplicate Letters
Detailed Scenario
A text-cleaning tool removes repeated adjacent letters caused by keyboard bounce.
Detailed Description
Given a lowercase string, repeatedly remove two equal adjacent characters until no such pair exists. Print the final string. If 
the final string is empty, print EMPTY.
Input Format
A single lowercase string S.
Output Format
Print the string after all removals. Print EMPTY if the result has no characters.
Constraints


1 <= |S| <= 100000
S contains lowercase English letters only.
Sample Input
abbaca
Sample Output
ca
Explanation
Use a stack. If the current character is equal to the stack top, pop it. Otherwise push it. For abbaca: remove bb, then aa, 
leaving ca.
List Implimentation :
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct node 
{
    char data;
    struct node * next;
}*head=NULL;
void push(char val){
    struct node * newnode = (struct node*)malloc(sizeof(struct node));
    newnode -> data = val;
    newnode -> next = head;
    head = newnode;
}
void pop(){
    struct node * temp = head;
    head = head -> next;
    free(temp);
}
void display(){
    struct node * temp = head;
    struct node * anshead = NULL;
    while(temp){
        struct node*ans = (struct node*)malloc(sizeof(struct node));
        ans -> data = temp -> data;
        ans -> next = anshead;
        anshead = ans;
        temp=temp->next;
    }
    struct node *fitemp = anshead;
    while(fitemp){
        printf("%c",fitemp->data);
        fitemp = fitemp -> next;
    }
}
int main()
{   
    char arr[100];
    scanf("%[^\n]",arr);
    for(int i=0;arr[i]!='\0';i++){
          if(head!=NULL && arr[i]==head -> data){
              pop();
          }
          else{
              push(arr[i]);
          }
        
    }
    if(head == NULL )printf("Empty");
 display();
    return 0;
}
3. Reverse Words Using Stack
Detailed Scenario
A command-line note application wants to display the words of a sentence in reverse order.
Detailed Description
Given a sentence with words separated by a single space, reverse the order of words using a stack. Characters inside each 
word must remain unchanged.
Input Format
A single line sentence S.
Output Format
Print the words in reverse order separated by one space.
Constraints



1 <= |S| <= 10000
Words contain lowercase/uppercase letters and digits.
There is exactly one space between words.
Sample Input
I love stack
Sample Output
stack love I
Explanation
Push each word into a stack, then pop and print words. Since stack is LIFO, the last word comes first.
Array Implementation:
#include <stdio.h>
int main()
{
    char arr[100];
    char stack[100];
    int top=-1;
    scanf(" %[^\n]",arr);
    for(int i=0;arr[i]!='\0';i++){
        if(arr[i] == ' '){
            int n = i-1;
            while(n>=0 &&arr[n]!=' '){
                stack[++top]=arr[n];
                n--;
            }
            stack[++top]=' ';
        }
        if(arr[i+1]=='\0'){
            int n = i;
            while(n>=0 &&arr[n]!=' '){
                stack[++top]=arr[n];
                n--;
            }
        }
    }
    while(top>-1){
        printf("%c",stack[top--]);
    }
    return 0;
}
